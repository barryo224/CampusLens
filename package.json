{
  "name": "campuslens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "frontend",
    "backend",
    "e2e"
  ],
  "scripts": {
    "dev:front": "npm run dev -w frontend",
    "dev:back": "npm run dev -w backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:e2e": "npm run test -w e2e",
    "check": "npm run lint && npm run format:check && npm run test",
    "db:generate": "npm run db:generate -w backend",
    "build": "npm run build -w frontend",
    "test:e2e:prod": "npm run build -w frontend && node scripts/e2e-prod.mjs",
    "verifier:secrets": "node scripts/verifier-secrets.mjs",
    "test:coverage": "npm run test:coverage -w backend && npm run test:coverage -w frontend",
    "lighthouse": "npm run build -w frontend && node scripts/lighthouse.mjs",
    "test:charge": "node scripts/test-charge.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
